+/*
+ * caffeinate fork: Firefox (necko) raises every request stream's receive
+ * window right after sending its HEADERS frame, so the stream-level
+ * WINDOW_UPDATE goes out after HEADERS and before any request DATA.
+ * The stream only exists in nghttp2 once HEADERS has been sent, so this is
+ * done from the on_frame_send callback. The queued WINDOW_UPDATE is a
+ * non-DATA frame and nghttp2 sends those before pending DATA frames.
+ */
+static int cf_h2_on_frame_send(nghttp2_session *session,
+                               const nghttp2_frame *frame, void *userp)
+{
+  if(frame->hd.type == NGHTTP2_HEADERS &&
+     frame->headers.cat == NGHTTP2_HCAT_REQUEST) {
+    struct Curl_easy *data_s =
+      nghttp2_session_get_stream_user_data(session, frame->hd.stream_id);
+    if(data_s && data_s->set.http2_stream_window_update > 0) {
+      int32_t stream_id = frame->hd.stream_id;
+      int32_t wsize =
+        nghttp2_session_get_stream_effective_local_window_size(session,
+                                                               stream_id);
+      int32_t inc = data_s->set.http2_stream_window_update;
+      if(wsize >= 0 && inc <= (int32_t)(0x7fffffff - wsize)) {
+        /* raises nghttp2's stream receive window and queues exactly one
+         * WINDOW_UPDATE(stream_id, inc). curl's own stream->local_window_size
+         * bookkeeping is left alone, so curl only touches the window again
+         * on pause/rate limiting, as before. */
+        int rv = nghttp2_session_set_local_window_size(
+          session, NGHTTP2_FLAG_NONE, stream_id, wsize + inc);
+        if(rv)
+          return NGHTTP2_ERR_CALLBACK_FAILURE;
+      }
+    }
+  }
+#ifdef CURLVERBOSE
+  return on_frame_send(session, frame, userp);
+#else
+  (void)userp;
+  return 0;
+#endif
+}
